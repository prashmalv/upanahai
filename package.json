{
  "name": "upanah-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Upanah.AI — AI-powered footwear recommendation, comparison, fit-scan & virtual try-on platform (India first).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
