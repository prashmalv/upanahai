# ---------------------------------------------------------------------------
# Upanah.AI environment variables
# Copy this file to `.env` and fill in values. The app RUNS WITHOUT any AI keys
# (it falls back to a smart heuristic engine), but real AI turns on the moment
# you add credentials below.
# ---------------------------------------------------------------------------

# Database. SQLite by default (zero-config). For Azure/Hostinger production,
# switch to Postgres/MySQL by changing provider in prisma/schema.prisma and
# setting a connection string here.
DATABASE_URL="file:./dev.db"

# Auth — used to sign JWT session cookies. Generate a long random string.
# e.g.  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# AI PROVIDER — choose ONE. If none set, heuristic fallback engine is used.
# ---------------------------------------------------------------------------

# Option A: Azure OpenAI (recommended since you host on Azure)
AZURE_OPENAI_ENDPOINT=""            # https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_CHAT_DEPLOYMENT=""     # e.g. gpt-4o
AZURE_OPENAI_VISION_DEPLOYMENT=""   # e.g. gpt-4o  (vision-capable)
AZURE_OPENAI_API_VERSION="2024-06-01"

# Option B: Standard OpenAI (leave Azure blank if using this)
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_VISION_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Virtual Try-On (VTON) — optional external model endpoint.
# If blank, the try-on page uses an in-browser overlay preview.
# Point this at your deployed VTON model (e.g. an Azure ML endpoint).
# ---------------------------------------------------------------------------
VTON_API_URL=""
VTON_API_KEY=""

# Public base URL (used for share links / redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
